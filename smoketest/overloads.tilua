-- TS-style function overloads: signature lines with no body, then the impl.

function len(x: string): number
function len(x: unknown[]): number
function len(x: string | unknown[]): number {
    return #x
}

function reverse(x: string): string
function reverse(x: number[]): number[]
function reverse(x) {
    return x
}

-- overload resolution: `len("hi")` picks the `(string) -> number` signature
const a = len("hi")
const b = reverse([1, 2, 3])
const c = reverse("abc")

print(a, b, c)
