-- Flow-sensitive narrowing that analyzeTypes should track.

type Shape =
    | { kind: "circle", radius: number }
    | { kind: "rect", w: number, h: number }

function area(shape: Shape): number {
    if (shape.kind == "circle") {
        return 3.14159 * shape.radius * shape.radius
    } else {
        return shape.w * shape.h
    }
}

function firstWord(s?: string): string {
    -- truthiness narrows `string | nil -> string`
    if (not s) {
        return ""
    }
    return s
}

const config: { debug: boolean } | nil = nil
const verbose = config and config.debug or false

print(area({ kind: "circle", radius: 2 }), firstWord(nil), verbose)

-- `or` refines only the false branch, where every operand's outcome is known.
-- The true branch must keep the un-narrowed type.
function branches(a: string | number) {
    if (a == 1 or a == "x") {
        -- not refinable: `string | number`
        const inOr = a
    } else {
        const afterOr = a
    }
}

-- A binding assigned in only one branch keeps the other path's type after the
-- `if` — here `flag` is `boolean` again, not the literal `true`.
function mergePaths(cond: boolean) {
    let flag: boolean = false
    if (cond) {
        flag = true
    }
    return flag
}

-- A declared property wins over the catch-all indexer for a known key.
type Bag = { [string]: number, label: string }
function readBag(bag: Bag): string {
    return bag["label"]
}

print(branches(1), mergePaths(true), readBag({ label: "x" }))
