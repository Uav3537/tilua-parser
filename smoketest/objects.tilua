-- Object literals: `{}` is objects only, JS colon syntax (`a: 1`, not `a = 1`).

const x, y = 10, 20

const point = { x: 1, y: 2 }
const shorthand = { x, y }
const stringKeys = { ["data-id"]: 42, ["order"]: "first" }

const key = "dynamic"
const computed = { [key]: true, [key .. "2"]: false }

const base = { a: 1, b: 2 }
const extended = { ...base, c: 3, b: 20 }

const nested = {
    position: { x: 0, y: 0 },
    tags: ["enemy", "flying"],
    onHit: function(dmg: number) {
        return dmg * 2
    },
}

print(point, shorthand, stringKeys, computed, extended, nested.position.x)
