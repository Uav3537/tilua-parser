-- Imports carry the exporting module's types. Every annotation below is an
-- assertion: if an import fell back to `any`, the negative cases at the end
-- would stop being errors — see the language server's tests for those.

import main, { ORIGIN, distance, scale, Point } from "./modules"

-- A value export keeps its declared or inferred type.
const origin: { x: number, y: number } = ORIGIN
const d: number = distance(ORIGIN, ORIGIN)
const s: number = scale

-- A type export is usable in annotations.
const p: Point = { x: 1, y: 2 }

-- The default export.
const r: number = main()

print(origin, d, s, p, r)

-- Through export lists and re-exports (see reexports.tilua).
import { clamp, lerp, help, VERSION, unit, area, surface, Size } from "./reexports"

const clamped: number = clamp(5, 0, 10)   -- from `export *`
const helped: number = help(1)            -- re-exported under a new name
const version: 3 = VERSION                -- re-exported as is
const size: Size = unit                   -- a type from an export list
const a1: number = area(unit)
const a2: number = surface(unit)          -- the same function, exported twice

print(clamped, lerp, helped, version, size, a1, a2)
