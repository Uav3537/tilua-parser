-- Several results are an array.
--
-- A function gives back one value. Several are an array — a tuple, when their
-- number and types are known — and the names are taken out of it with a
-- destructuring. An array is a table: `return [1, "a"]` is `return { 1, "a" }`.

function two(): [number, string] {
    return [1, "a"]
}

-- Taken apart where it is received…
const [first, second] = two()
const firstIsNumber: number = first
const secondIsString: string = second

-- …or kept whole, as the array it is.
const both: [number, string] = two()
const fromBoth: string = both[2]

-- A tuple can end in a rest: at least the named ones, then any number more.
function atLeastOne(): [string, ...number[]] {
    return ["label", 1, 2, 3]
}
const [label, ...values] = atLeastOne()
const labelIsString: string = label
const valuesAreNumbers: number[] = values

-- Several names are taken from an array, like any other.
const [x, y] = [1, "b"]

-- A `while` exits when its condition fails, so what the condition ruled out
-- holds afterwards — unless a `break` can skip that.
function firstNonNil(v: string | nil) {
    while (v == nil) {
        v = "fallback"
    }
    const settled: string = v
    return settled
}

function mightBreak(v: string | nil) {
    while (v == nil) {
        break
    }
    -- the loop may have been left by `break`, so nothing is known
    const unsettled: string | nil = v
    return unsettled
}

print(firstIsNumber, secondIsString, fromBoth, labelIsString, valuesAreNumbers, x, y,
      firstNonNil(nil), mightBreak(nil))
