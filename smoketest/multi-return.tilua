-- Lua's multi-value adjustment.
--
-- In an expression list every expression but the last yields exactly one
-- value; the last yields all of its values if it is a call or `...`.
-- Parentheses truncate back to one. That rule is what makes `pcall`,
-- `string.find` and `next` usable, so the checker follows it rather than
-- treating a multi-return as a single tuple value.

function two(): (number, string) {
    return 1, "a"
}

-- The last expression expands to fill the remaining names…
const first: number, second: string = two()

-- …and a name with nothing left to take is nil-ish rather than a value.
const a: number, b: string, spare: unknown = two()

-- In a single-value position only the first value survives.
const justFirst: number = two()

-- Earlier positions contribute one value each; only the last expands.
const one: 1, expanded: number = 1, two()

-- Parentheses truncate.
const truncated: number = (two())

-- A `while` exits when its condition fails, so what the condition ruled out
-- holds afterwards — unless a `break` can skip that.
function firstNonNil(v: string | nil) {
    while (v == nil) {
        v = "fallback"
    }
    const settled: string = v
    return settled
}

function mightBreak(v: string | nil) {
    while (v == nil) {
        break
    }
    -- the loop may have been left by `break`, so nothing is known
    const unsettled: string | nil = v
    return unsettled
}

print(first, second, a, b, spare, justFirst, one, expanded, truncated,
      firstNonNil(nil), mightBreak(nil))
