-- `class ... end`: one table per class, one table per instance, and the
-- instance points at the class. Everything here is sugar over that.

export class Animal {
    -- A field with a type is set by the constructor; one with a value is set
    -- for every instance before the constructor body runs.
    name: string
    legs = 4
    -- A static lives on the class table, and nowhere else.
    static count = 0

    constructor(name: string) {
        this.name = name
        Animal.count += 1
    }

    function speak(): string {
        return `${this.name} makes a sound`
    }

    -- Read as a property, run as a function.
    get label(): string {
        return `<${this.name}>`
    }

    set label(value: string) {
        this.name = value
    }

    static function made(): number {
        return Animal.count
    }
}

export class Dog extends Animal {
    breed: string

    constructor(name: string, breed: string) {
        super(name)
        this.breed = breed
    }

    function speak(): string {
        return `${super.speak()} (woof, ${this.breed})`
    }

    function fetch(item: string): string {
        return `${this.name} fetched ${item}`
    }
}

-- A class with no constructor takes whatever the one it extends takes.
export class Puppy extends Dog {
    function speak(): string {
        return `${super.speak()}!`
    }
}

const rex = new Dog("Rex", "shiba")
const said: string = rex:speak()
const shown: string = rex.label
const legs: number = rex.legs
const asAnimal: Animal = rex

rex.label = "Max"

const pip = new Puppy("Pip", "pug")
const fetched: string = pip:fetch("ball")
const total: number = Animal.count
const made: number = Dog.made()

-- The class table is a value like any other: it can be passed around, and
-- `new` is the same call as `Dog.new`.
function build(make: (name: string, breed: string) => Dog): Dog {
    return make("Spot", "beagle")
}

const built: Dog = build(Dog.new)

-- A generic class. The instance type is generic too: `Box<number>` and
-- `Box<string>` are both `Box`, and neither is the other.
export class Box<T> {
    value: T

    constructor(value: T) {
        this.value = value
    }

    function get(): T {
        return this.value
    }

    function map<R>(f: (value: T) => R): Box<R> {
        return new Box(f(this.value))
    }
}

const ofNumber: Box<number> = new Box(1)
const ofString: Box<string> = ofNumber:map(function(n) { return tostring(n) })
const held: number = ofNumber:get()

-- Extending a generic class fixes its argument.
export class Ints extends Box<number> {
    constructor(n: number) {
        super(n)
    }

    function double(): number {
        return this:get() * 2
    }
}

-- A class written where a value goes. It is known by the name it is bound to.
const Counter = class {
    n = 0

    function bump(): number {
        this.n += 1
        return this.n
    }
}

const counter = new Counter()
const bumped: number = counter:bump()

-- The links the memory model promises: an instance names its class, a class
-- names the one it extends.
const itsClass = counter.ClassObject
const dogsParent = Dog.ParentClass
const animalsParent = Animal.ParentClass
