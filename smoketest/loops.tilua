-- Destructuring in generic-for; numeric-for stays a plain identifier.

const pairsList = [["a", 1], ["b", 2], ["c", 3]]
const records = [
    { id: 1, label: "one" },
    { id: 2, label: "two" },
]

for (i, entry in ipairs(pairsList)) {
    print(i, entry)
}

-- generalized iteration: each element is yielded directly
for (record in records) {
    print(record.id, record.label)
}

for (i = 1, 10) {
    print(i)
}

for (i: number = 10, 1, -1) {
    print(i)
}

for (key, { deep } in pairs({ x: { deep: 1 } })) {
    print(key, deep)
}
