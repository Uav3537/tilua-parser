-- A loop takes one value each time; several are an array it takes apart.
-- Numeric-for stays a plain identifier.

const pairsList = [["a", 1], ["b", 2], ["c", 3]]
const records = [
    { id: 1, label: "one" },
    { id: 2, label: "two" },
]

-- an iteration: `[step, state, first]`, whose steps are one `[i, value]` each
for (const [i, entry] in ipairs(pairsList)) {
    print(i, entry)
}

-- a table walked as it is: each item is one of its values
for (const record in records) {
    print(record.id, record.label)
}

for (i = 1, 10) {
    print(i)
}

for (i: number = 10, 1, -1) {
    print(i)
}

-- the item taken apart by a pattern, as deep as it goes
for (const [key, { deep }] in pairs({ x: { deep: 1 } })) {
    print(key, deep)
}

-- an iterator function: called until it answers nil
function counter(limit: number): () => number | nil {
    let n = 0
    return function(): number | nil {
        n += 1
        if (n > limit) { return nil }
        return n
    }
}

for (const n in counter(3)) {
    print(n)
}
